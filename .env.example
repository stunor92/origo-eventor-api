# Copy this file to .env and fill in values for local development against staging.
# .env is gitignored and never committed.
#
# Load before starting the app:
#   export $(cat .env | xargs) && ./mvnw ktor:run
#
# In IntelliJ: Run Configuration → Environment variables → load from file (.env)

PORT=8080

SUPABASE_PROJECT_REF=<project-ref>
POSTGRES_DB=jdbc:postgresql://<host>:5432/<db>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<secret>
